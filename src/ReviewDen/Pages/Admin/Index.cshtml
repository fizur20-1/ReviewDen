@page "/admin"
@model ReviewDen.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Admin"; }

<h1 class="h4">Moderation</h1>
<p class="small text-muted">Items auto-hide at @Db.AutoHideReports reports. Hide/Show resets the report count.
    <a href="?all=@(!Model.All)">@(Model.All ? "Only reported" : "All recent posts")</a></p>

<h2 class="h5 mt-4">Posts</h2>
<table class="table table-sm bg-white align-middle">
    @foreach (var p in Model.Posts)
    {
        <tr class="@(p.Hidden ? "table-secondary" : "")">
            <td><img src="/uploads/@p.ImagePath" width="48" height="48" style="object-fit:cover" alt="" /></td>
            <td><a href="/p/@p.Id">@p.Title</a><div class="small text-muted">@p.AuthorName</div></td>
            <td>@Ui.Icon("flag") @p.Reports</td>
            <td>
                <form method="post" asp-page-handler="Post" asp-route-id="@p.Id" asp-route-hide="@(!p.Hidden)">
                    <button class="btn btn-sm @(p.Hidden ? "btn-outline-success" : "btn-outline-danger")">@(p.Hidden ? "Show" : "Hide")</button>
                </form>
            </td>
        </tr>
    }
</table>

<h2 class="h5 mt-4">Comments</h2>
<table class="table table-sm bg-white align-middle">
    @foreach (var c in Model.Comments)
    {
        <tr class="@(c.Hidden ? "table-secondary" : "")">
            <td><a href="/p/@c.PostId#comments">#@c.PostId</a></td>
            <td class="post-body">@c.Body<div class="small text-muted">@c.AuthorName</div></td>
            <td>@Ui.Icon("flag") @c.Reports</td>
            <td>
                <form method="post" asp-page-handler="Comment" asp-route-id="@c.Id" asp-route-hide="@(!c.Hidden)">
                    <button class="btn btn-sm @(c.Hidden ? "btn-outline-success" : "btn-outline-danger")">@(c.Hidden ? "Show" : "Hide")</button>
                </form>
            </td>
        </tr>
    }
</table>
